[Container]
Image=ghcr.io/flaresolverr/flaresolverr:latest
ContainerName=flaresolverr
AutoUpdate=registry

Environment=LOG_LEVEL=info LOG_HTML=false CAPTCHA_SOLVER=none TZ=Europe/London SEARXNG_PORT=3001

Network=xray.network

[Service]
Restart=always

[Install]
WantedBy=default.target

#/* vim: set filetype=systemd: */
