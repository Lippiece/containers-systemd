[Container]
Image=docker.io/livekit/livekit-server:latest
ContainerName=element-call-livekit
AutoUpdate=registry

Exec=--config /etc/livekit/livekit.yaml

PublishPort=4240:7880
PublishPort=3210:3120
PublishPort=7881:7881
PublishPort=50100-50200:50100-50200/udp

Volume=livekit_data:/etc/livekit

[Unit]
Requires=synapse.service
After=synapse.service

[Service]
Restart=always

[Install]
WantedBy=default.target

#/* vim: set filetype=systemd: */
