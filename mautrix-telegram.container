[Container]
ContainerName=mautrix-telegram
Image=localhost/mautrix-iptabled:latest

Volume=mautrix-telegram:/data

PublishPort=4220:29317

Network=synapse.network
Network=xray.network

AddCapability=NET_ADMIN
[Unit]
Requires=synapse.service xray.service

[Service]
Restart=always

[Install]
WantedBy=default.target

#/* vim: set filetype=systemd: */
