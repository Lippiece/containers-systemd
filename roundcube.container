[Container]
ContainerName=roundcube
AutoUpdate=registry
Image=docker.io/roundcube/roundcubemail:latest

Environment=DNS=9.9.9.9 ROUNDCUBEMAIL_COMPOSER_PLUGINS=toteph42/identity_switch,texxasrulez/persistent_login,kitist/html5_notifier,mmvi/twofactor_webauthn,roundcube/carddav ROUNDCUBEMAIL_INSTALL_PLUGINS=1
# scopen-coop/roundcube_caldav,
EnvironmentFile=roundcube.env


Volume=roundcube_config:/var/roundcube/config/
Volume=roundcube:/var/www/html/

PublishPort=3300:80

[Unit]
Wants=roundcube-db.service

[Install]
WantedBy=default.target

#/* vim: set filetype=systemd: */
